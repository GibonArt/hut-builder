# Zkopíruj tento soubor jako `.env` a vyplň hodnoty.
# Supabase: https://supabase.com/dashboard → projekt → Settings → API
#
# Pozn.: Proměnné začínající NEXT_PUBLIC_ se při `docker compose build` vloží do frontendu.
# Po změně URL nebo klíčů znovu sestav image: docker compose build --no-cache

# Povinné — Auth + NHL26 data (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Použij jeden z následujících veřejných klíčů (anon nebo nový publishable — podle dashboardu):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Volitelné alternativy k anon klíči (stačí vyplnit jednu variantu):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- NHL27 (oddělená DB, prázdný start) ---
# Stejný JWT secret jako u NHL26 (self-hosted), aby Auth token fungoval i proti NHL27 RLS.
# Veřejná HTTPS URL (bez interní IP). Hairpin z Dockeru řeší extra_hosts v docker-compose.yml.
# NEXT_PUBLIC_SUPABASE_NHL27_URL=https://supabase27.kc36gaming.gibonart.cz
# NEXT_PUBLIC_SUPABASE_NHL27_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_NHL27_PUBLISHABLE_KEY=
# SUPABASE_NHL27_SERVICE_ROLE_KEY=
# Stejná veřejná URL i pro server API (bez 192.168.x / 172.17.x):
# SUPABASE_NHL27_URL=https://supabase27.kc36gaming.gibonart.cz
#
# Alternativa ve stejné Docker síti jako Kong (bez HTTPS):
# SUPABASE_NHL27_URL=http://supabase-nhl27-kong:8000

# Volitelné — Cloudflare Turnstile (veřejný site key).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Volitelné — vlastní port na hostiteli (výchozí 3000).
# HUT_PORT=3000

# Pouze pro skripty na NAS / lokálně — NIKDY do frontendu, NIKDY commitovat.
# SUPABASE_SERVICE_ROLE_KEY=
# HUT_IMPORT_EDITOR_USER_ID=
# HUT_IMPORT_EDITOR_EMAIL=gibonart@gmail.com

# Volitelné — hromadné e-maily z /admin/uzivatele (Resend)
# RESEND_API_KEY=re_xxxxxxxx
# HUT_EMAIL_FROM="HUT <newsletter@tvoje-overena-domena.cz>"

# Soukromý HUT — jen admin (lib/bonusAdmin.ts).
# HUT_PRIVATE_ADMIN_ONLY=1
