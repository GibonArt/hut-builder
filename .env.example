# Zkopíruj tento soubor jako `.env` a vyplň hodnoty.
# Supabase: https://supabase.com/dashboard → projekt → Settings → API
#
# Pozn.: Proměnné začínající NEXT_PUBLIC_ se při `docker compose build` vloží do frontendu.
# Po změně URL nebo klíčů znovu sestav image: docker compose build --no-cache

# Povinné — URL projektu (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Použij jeden z následujících veřejných klíčů (anon nebo nový publishable — podle dashboardu):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Volitelné alternativy k anon klíči (stačí vyplnit jednu variantu):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Volitelné — Cloudflare Turnstile (veřejný site key). Spolu s zapnutou CAPTCHA v Supabase
# (Dashboard → Authentication → Bot and Abuse Protection → Enable CAPTCHA → Turnstile + secret).
# Bez této proměnné se widget nezobrazí a přihlášení/registrace jdou bez tokenu (jen pokud máš CAPTCHA vypnutou).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Volitelné — vlastní port na hostiteli (výchozí 3000). V docker-compose.yml: ports: "${HUT_PORT:-3000}:3000"
# HUT_PORT=3000

# Pouze pro skripty na NAS / lokálně (import kombinací bez prohlížeče) — NIKDY do frontendu, NIKDY commitovat.
# Supabase → Settings → API → service_role (secret).
# SUPABASE_SERVICE_ROLE_KEY=
# Volitelně UUID admina pro sloupec updated_by (jinak se najde e-mail gibonart@gmail.com):
# HUT_IMPORT_EDITOR_USER_ID=
# HUT_IMPORT_EDITOR_EMAIL=gibonart@gmail.com

# Volitelné — hromadné e-maily z admin stránky /admin/uzivatele (Resend: https://resend.com )
# RESEND_API_KEY=re_xxxxxxxx
# HUT_EMAIL_FROM="HUT <newsletter@tvoje-overena-domena.cz>"
