# Zkopíruj na NAS (NEcommituj — obsahuje heslo):
#   cp supabase/scripts/export-cloud.env.example export/cloud.env
#   nano export/cloud.env
#
# === DOPORUČENO: heslo se speciálními znaky (@ # % ! …) — bez URL enkódování ===
# Hodnoty z Dashboard → Database → Connection string → Session pooler (port 5432)

CLOUD_HOST=aws-0-eu-central-1.pooler.supabase.com
CLOUD_USER=postgres.mfeuiplsndvnmnjmqaus
CLOUD_PASSWORD='Sem vloz heslo i s @ # % ! znaky'
CLOUD_PORT=5432
CLOUD_DB=postgres

# Heslo v jednoduchých uvozovkách '...' — uvnitř nesmí být znak '
# Když heslo obsahuje ', použij: CLOUD_PASSWORD="heslo s ' uvozovkou"

# === Alternativa: jeden řetězec CLOUD_URI (heslo musí být URL-enkódované) ===
# @ → %40   # → %23   % → %25   ! → %21   & → %26
# CLOUD_URI=postgresql://postgres.REF:HESLO%40ENC@aws-0-REGION.pooler.supabase.com:5432/postgres

# Direct db.*.supabase.co na Synology nefunguje (jen IPv6).

# EXPORT_AUTH=1
