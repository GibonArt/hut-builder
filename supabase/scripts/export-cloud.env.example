# export/cloud.env — NEcommituj (heslo)
#
# === HESLO S @ — nepoužívej CLOUD_URI (zavináč rozbije URI) ===
# Hodnoty: Dashboard → Database → Session pooler (port 5432)

CLOUD_HOST=aws-0-eu-central-1.pooler.supabase.com
CLOUD_USER=postgres.mfeuiplsndvnmnjmqaus

# Varianta A — heslo v uvozovkách:
# CLOUD_PASSWORD='heslo@s@pec@ial'

# Varianta B — heslo v samostatném souboru (nejspolehlivější pro @):
#   printf '%s' 'heslo@s@pec@ial' > export/cloud.password
#   chmod 600 export/cloud.password
CLOUD_PASSWORD_FILE=export/cloud.password

CLOUD_PORT=5432
CLOUD_DB=postgres

# CLOUD_URI=...   ← nech zakomentované / smaž, když používáš výše

# EXPORT_AUTH=1
