# Zkopíruj na NAS (NEcommituj — obsahuje heslo k DB):
#   cp supabase/scripts/export-cloud.env.example export/cloud.env
#   nano export/cloud.env
#
# Supabase Dashboard → Project Settings → Database → Connection string → URI → Direct connection
CLOUD_URI=postgresql://postgres.TVUJ_REF:TVUJE_HESLO@db.TVUJ_REF.supabase.co:5432/postgres

# Když NAS hlásí „Cannot assign requested address“ (IPv6): skript vynutí IPv4 automaticky.
# Alternativa: Session pooler URI z Dashboardu (host aws-*-*.pooler.supabase.com, port 5432).
# Nebo export na Macu a scp export/*.sql na NAS.

# Volitelně: export i auth.users (obvykle NE — na NAS už máš uživatele z hut-turnaj)
# EXPORT_AUTH=1
