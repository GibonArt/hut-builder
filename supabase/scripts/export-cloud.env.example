# Zkopíruj na NAS (NEcommituj — obsahuje heslo k DB):
#   cp supabase/scripts/export-cloud.env.example export/cloud.env
#   nano export/cloud.env
#
# === NA SYNOLOGY (bez IPv6) použij SESSION POOLER, ne Direct connection ===
# Dashboard → Project Settings → Database → Connection string
# → záložka "Session pooler" → URI → port 5432
#
# Příklad (REGION a REF z tvého Dashboardu):
CLOUD_URI=postgresql://postgres.mfeuiplsndvnmnjmqaus:TVUJE_HESLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Direct connection (db.*.supabase.co) má často JEN IPv6 — na NAS nefunguje:
# CLOUD_URI=postgresql://postgres.REF:HESLO@db.REF.supabase.co:5432/postgres
#
# Alternativa: export na Macu a scp export/hut-builder-public-data-pg15.sql na NAS.

# Volitelně: export i auth.users (obvykle NE — na NAS už máš uživatele z hut-turnaj)
# EXPORT_AUTH=1
